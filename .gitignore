# =====================================================================
# This repo is scoped to flask-storefront/. The parent folder also holds
# a broken virtualenv, logo assets and other artifacts that must NEVER be
# committed. Ignore ALL top-level entries except the few we track.
# =====================================================================
/*
!/.gitignore
!/render.yaml
!/requirements.txt
!/flask-storefront/

# --- also ignored anywhere inside tracked dirs ---
.env
*.env
*.db
instance/
venv/
__pycache__/
*.pyc
.Python
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
